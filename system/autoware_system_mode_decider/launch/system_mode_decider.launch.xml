<launch>
  <arg name="config" default="$(find-pkg-share autoware_system_mode_decider)/config/system_mode_decider.param.yaml"/>
  <!-- <arg name="output/control" default="/control/command/control_cmd"/> -->

  <!-- Enabled if "main" is listed in config input_names -->
  <!-- <arg name="inputs/main/control" default="/control/trajectory_follower/control_cmd"/> -->

  <node pkg="autoware_system_mode_decider" exec="system_mode_decider_node">
    <param from="$(var config)"/>
    <remap from="~/trajectory/source/status" to="/planning/trajectory_gate/source/status"/>
    <remap from="~/trajectory/source/select" to="/planning/trajectory_gate/source/select"/>
    <remap from="~/command/source/status" to="/control/control_command_gate/source/status"/>
    <remap from="~/command/source/select" to="/control/control_command_gate/source/select"/>
    <remap from="~/vehicle/source/status" to="/vehicle/status/control_mode"/>
  </node>
</launch>
